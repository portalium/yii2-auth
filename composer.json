{
	"name" : "portalium/yii2-auth",
	"description" : "auth Module for Portalium (Yii2)",
	"type" : "portalium-module",
	"license": "MIT",
	"homepage" : "https://portalium.dev",
	"authors" : [
		{
			"name" : "Uğur YILDIZ",
			"email" : "yildiz@diginova.com.tr",
			"homepage" : "https://uguryildiz.net"
		}
	],
	"support" : {
		"issues" : "https://github.com/portalium/yii2-auth/issues"
	},
	"require": {
		"firebase/php-jwt": "dev-main",
        "google/apiclient": "^1.1",
		"portalium/yii2-site": "*"
	},
	"suggest": {
		"freedsx/ldap": "Needed only for LDAP / Active Directory identity providers (^0.9, plain PHP, no extension).",
		"onelogin/php-saml": "Needed only for SAML identity providers (^4.2)."
	},
	"autoload" : {
		"psr-4" : {
			"portalium\\auth\\" : "src/"
		}
	}
}